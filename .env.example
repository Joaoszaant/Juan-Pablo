# Copie para .env e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A chave "anon" é pública por natureza;
# a segurança vem das permissões definidas em supabase/schema.sql.
# NUNCA coloque a chave service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
